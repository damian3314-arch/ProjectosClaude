{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectosclaude",
  "account_id": "bf3b8e522cb09f86017e2ac7c0d16ea8",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true }, // true: las cabeceras de seguridad se aplican también a la página
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "damian-web",
      "database_id": "62ecc723-7c3d-4d31-8b90-a1b422966cdb",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 * * * *", "*/5 * * * *"] },
  "routes": [
    { "pattern": "holadami.com", "custom_domain": true },
    { "pattern": "www.holadami.com", "custom_domain": true }
  ],
  // Valores públicos. Las claves (OPENAI_API_KEY, KAPSO_API_KEY, ADMIN_TOKEN, IP_SALT) y OWNER_WHATSAPP (tu número personal, el repo es público) van como secretos.
  "vars": {
    "OPENAI_MODEL": "gpt-4o-mini",
    "AGENT_MODEL": "gpt-6.1-terra",   // el cerebro de Alter (conversa y califica); si la cuenta no lo tiene, cae a OPENAI_MODEL. Más barato: "gpt-6-luna"
    "AGENT_REASONING": "low",         // none | low | medium | high: más razonamiento = más lento y más caro
    "OPENAI_TRANSCRIBE_MODEL": "whisper-1",
    // WhatsApp: API de Meta directo (ver WHATSAPP.md). Secretos que van aparte: WA_TOKEN, WA_APP_SECRET, WA_VERIFY_TOKEN.
    "WA_PHONE_NUMBER_ID": "",    // id del número de Alter en Meta (WhatsApp Manager → el número → "Identificador del número de teléfono"), NO el teléfono
    "WA_SENDER_NUMBER": "573334021068",   // el número de Alter: los avisos nunca se envían a este mismo número
    "WA_NOTIFY_TEMPLATE": "aviso_lead",
    "WA_ALERT_TEMPLATE": "aviso_lead",
    "WA_LEAD_TEMPLATE": "",
    "WA_TEMPLATE_LANG": "es",
    "AGENT_ALLOWLIST": "off",   // línea propia de Alter: atiende a cualquiera que escriba (antes solo a quien dijera "holadami")
    "AUTO_CONTACT_LEADS": "false",
    "AGENDA_HOURS": "9,10,11,14,15,16", // horas de inicio que Alter puede ofrecer para demos (Colombia, lunes a viernes, sin festivos)
    "OUTBOX_PER_DAY": "150",
    "OUTBOX_PER_RUN": "10",    // cuántos primeros mensajes salen en cada revisión (cada 5 min): así cada ola sale escalonada   // tope diario de primeros mensajes por plantilla mientras el número nuevo se calienta
    "OUTBOX_ALIAS": "{}",      // p. ej. {"loggro_primer_contacto":"solicitud_loggro_en_proceso"} para cambiar de plantilla sin tocar la rutina
    "ALERT_OPEN_TEMPLATE": "alerta_nueva_solicitud",   // plantilla de utilidad aprobada: avisa a Damián cuando su ventana de 24 h está cerrada
    "ALERT_OPEN_TEXT": "on",                          // la plantilla lleva el resumen del aviso
    "ALTER_WHATSAPP": "",      // número público de Alter (solo dígitos, con 57). Vacío = la página no muestra botón ni número. Se llena cuando el número nuevo esté conectado en Kapso
    "LOGGRO_OUTREACH": "off",  // "off": el servidor no le escribe a ningún lead de Loggro ni manda avisos de esa campaña. "on" la reactiva
    "RESCATE_ENVIOS": "off",   // campaña de rescate de leads viejos de Loggro (cola en loggro_leads); "off" la pausa
    "AGENT_V2": "on",   // agente conversacional (chat como Damián); "off" vuelve al flujo de botones
    "BOOKING_URL_LOGGRO": "",
    "BOOKING_URL_PERSONAL": ""
  }
}
